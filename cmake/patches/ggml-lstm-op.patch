+// =========================================================================
+// tifa.cpp patch: fused batched LSTM sweep (English G2P).
+// See ggml_lstm() in include/ggml.h for the tensor contract.  Parallel over
+// the batch; serial over the time-steps (the recurrence is inherently
+// sequential).  Gate rows in gi_all / whh / bhh follow the ONNX LSTM order
+// i, o, f, c.
+// =========================================================================
+void ggml_compute_forward_lstm(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * whh = dst->src[0];  // [H, 4H]
+    const ggml_tensor * gi  = dst->src[1];  // [4H, B, L]
+    const ggml_tensor * bhh = dst->src[2];  // [4H]
+    const ggml_tensor * h0  = dst->src[3];  // [H, B] or NULL (zeros)
+    const ggml_tensor * c0  = dst->src[4];  // [H, B] or NULL (zeros)
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && whh->type == GGML_TYPE_F32 &&
+                gi->type == GGML_TYPE_F32 && bhh->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(dst) && ggml_is_contiguous(whh) &&
+                ggml_is_contiguous(gi) && ggml_is_contiguous(bhh));
+    GGML_ASSERT(h0 == NULL || (h0->type == GGML_TYPE_F32 && ggml_is_contiguous(h0)));
+    GGML_ASSERT(c0 == NULL || (c0->type == GGML_TYPE_F32 && ggml_is_contiguous(c0)));
+
+    const int64_t H  = whh->ne[0];
+    const int64_t H4 = whh->ne[1];   // 4*H
+    const int64_t B  = gi->ne[1];
+    const int64_t L  = gi->ne[2];
+    const bool reverse = ggml_get_op_params_i32(dst, 0) != 0;
+
+    const float * whh_d = (const float *) whh->data;   // whh[g*H + k]
+    const float * gi_d  = (const float *) gi->data;    // gi[g + H4*b + H4*B*t]
+    const float * bhh_d = (const float *) bhh->data;   // bhh[g]
+    const float * h0_d  = h0 ? (const float *) h0->data : NULL;   // h0[k + H*b]
+    const float * c0_d  = c0 ? (const float *) c0->data : NULL;
+
+    // dst [H, B, L+2]: planes 0..L-1 the h sequence, plane L the final h,
+    // plane L+1 the final c; element [k, b, plane] at k + H*b + H*B*plane.
+    float * dst_d = (float *) dst->data;
+    float * hT_d  = dst_d + H * B * L;
+    float * cT_d  = dst_d + H * B * (L + 1);
+
+    const int64_t per = (B + params->nth - 1) / params->nth;
+    const int64_t b0  = (int64_t) params->ith * per;
+    int64_t b1 = b0 + per;
+    if (b1 > B) b1 = B;
+
+    std::vector<float> h(H);
+    std::vector<float> c(H);
+    std::vector<float> gh(H4);
+
+    for (int64_t b = b0; b < b1; ++b) {
+        if (h0_d) {
+            memcpy(h.data(), h0_d + H*b, H*sizeof(float));
+        } else {
+            std::fill(h.begin(), h.end(), 0.0f);
+        }
+        if (c0_d) {
+            memcpy(c.data(), c0_d + H*b, H*sizeof(float));
+        } else {
+            std::fill(c.begin(), c.end(), 0.0f);
+        }
+
+        for (int64_t s = 0; s < L; ++s) {
+            const int64_t t   = reverse ? (L - 1 - s) : s;
+            const float * gip = gi_d + (H4 * b + H4 * B * t);
+
+            // gh = whh*h + bhh
+            for (int64_t g = 0; g < H4; ++g) {
+                const float * wrow = whh_d + H * g;
+                float acc = bhh_d[g];
+                for (int64_t k = 0; k < H; ++k) acc += wrow[k] * h[k];
+                gh[g] = acc;
+            }
+
+            float * outp = dst_d + (H * b + H * B * t);
+            for (int64_t k = 0; k < H; ++k) {
+                const float ig = 1.0f / (1.0f + expf(-(gip[k]             + gh[k])));
+                const float og = 1.0f / (1.0f + expf(-(gip[H + k]         + gh[H + k])));
+                const float fg = 1.0f / (1.0f + expf(-(gip[2 * H + k]     + gh[2 * H + k])));
+                const float gg = tanhf(gip[3 * H + k]                     + gh[3 * H + k]);
+                const float cn = fg * c[k] + ig * gg;
+                const float hn = og * tanhf(cn);
+                c[k] = cn;
+                h[k] = hn;
+                outp[k] = hn;
+                hT_d[H * b + k] = hn;
+                cT_d[H * b + k] = cn;
+            }
+        }
+    }
+}
