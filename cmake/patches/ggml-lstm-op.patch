+// tifa.cpp patch: fused batched LSTM sweep (English G2P encoder/decoder).
+// See ggml_lstm() in include/ggml.h for the exact tensor contract.
+struct ggml_tensor * ggml_lstm(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * whh,
+        struct ggml_tensor  * gi_all,
+        struct ggml_tensor  * bhh,
+        struct ggml_tensor  * h0,
+        struct ggml_tensor  * c0,
+        bool                  reverse) {
+    GGML_ASSERT(whh->type    == GGML_TYPE_F32);
+    GGML_ASSERT(gi_all->type == GGML_TYPE_F32);
+    GGML_ASSERT(bhh->type    == GGML_TYPE_F32);
+    GGML_ASSERT(h0 == NULL || h0->type == GGML_TYPE_F32);
+    GGML_ASSERT(c0 == NULL || c0->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(whh));
+    GGML_ASSERT(ggml_is_contiguous(gi_all));
+    GGML_ASSERT(ggml_is_contiguous(bhh));
+    GGML_ASSERT(h0 == NULL || ggml_is_contiguous(h0));
+    GGML_ASSERT(c0 == NULL || ggml_is_contiguous(c0));
+
+    const int64_t H = whh->ne[0];
+    const int64_t B = gi_all->ne[1];
+    const int64_t L = gi_all->ne[2];
+    GGML_ASSERT(whh->ne[1] == gi_all->ne[0]);
+    GGML_ASSERT(bhh->ne[0] == gi_all->ne[0]);
+    GGML_ASSERT(h0 == NULL || (h0->ne[0] == H && h0->ne[1] == B));
+    GGML_ASSERT(c0 == NULL || (c0->ne[0] == H && c0->ne[1] == B));
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, H, B, L + 2);
+
+    int32_t params[1] = { reverse ? 1 : 0 };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_LSTM;
+    result->src[0] = whh;
+    result->src[1] = gi_all;
+    result->src[2] = bhh;
+    result->src[3] = h0;
+    result->src[4] = c0;
+
+    return result;
+}
